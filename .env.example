# Backend Configuration
DATABASE_URL=sqlite:///./chat.db

# Security: Use "*" only for local dev. In production, specify exact domain(s)
# Example: https://yourfrontend.onrender.com,https://yourfrontend.com
# If "*" is used, credentials are disabled (safe default)
ALLOWED_ORIGINS=*

# Frontend Configuration
REACT_APP_API_BASE=http://localhost:8080
